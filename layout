#!/usr/bin/env bash
set -euo pipefail

CWD=$(zoxide query $1)

WORKSPACE_CREATION_RESULT=$(herdr workspace create --cwd $CWD)
WORKSPACE_ID=$(echo $WORKSPACE_CREATION_RESULT | jq -r ".result.workspace.workspace_id")

DEFAULT_TAB_ID=$(echo $WORKSPACE_CREATION_RESULT | jq -r ".result.tab.tab_id")

cd templates

TEMPLATE_FILE=$(fzf)

while IFS=$'\t' read -r name cmd; do
    pane_id=$(
        herdr tab create \
            --label "$name" \
            --workspace "$WORKSPACE_ID" |
        jq -r '.result.root_pane.pane_id'
    )

    if [[ -n "$cmd" ]]; then
        herdr pane send-text "$pane_id" "$cmd"
        herdr pane send-keys "$pane_id" enter
    fi
done < <(
    jq -r '.[] | [.name, (.cmd // "")] | @tsv' "$TEMPLATE_FILE"
)

herdr tab close $DEFAULT_TAB_ID
herdr workspace focus $WORKSPACE_ID
herdr pane close $HERDR_PANE_ID
