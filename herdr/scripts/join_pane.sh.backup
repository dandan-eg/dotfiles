#!/usr/bin/env bash

# Herdr join_pane equivalent script
# Moves current pane to next tab with horizontal split (right)
# Result: [existing_pane][moved_pane] in next tab

# Get current pane and tab IDs


let i=0
let current_found=0

while true; do	
	TAB=$(herdr pane list --workspace $HERDR_WORKSPACE_ID | jq -r ".result.panes[$i].tab_id")
	PANE=$(herdr pane list --workspace $HERDR_WORKSPACE_ID | jq -r ".result.panes[$i].pane_id")


	if [ $TAB = "null" ]; then
		break
	fi

	if [ $TAB = $HERDR_TAB_ID ]; then
		current_found=1
	else
		if [ $current_found -eq 1 ]; then
			# move
			herdr pane move $HERDR_PANE_ID --tab $HERDR_TAB_ID --split right
			break
		fi
	fi
	((i++))
done

# move
